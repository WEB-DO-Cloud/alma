---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SELF_HOST_GUIDE_PATH } from "../site";
---

<BaseLayout
  title="Page not found · ALMA"
  description="The requested ALMA page does not exist."
  index={false}
>
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Page not found</h1>
      <p>The page you requested does not exist. Return home or continue with the self-hosting guide.</p>
      <div class="cta-actions">
        <Button href="/">Home</Button>
        <Button href={SELF_HOST_GUIDE_PATH} variant="secondary">Read the docs</Button>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
