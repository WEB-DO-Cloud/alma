---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SELF_HOST_GUIDE_PATH } from "../site";
---

<BaseLayout title="Support · ALMA" description="Get help with the ALMA app and self-hosted ALMA.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>ALMA support</h1>
      <p>
        For help with the ALMA mobile app or a hosted ALMA account, email{" "}
        <a href="mailto:hello@alma.com.do">hello@alma.com.do</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2>Self-hosted ALMA</h2>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. On the web, sign in at{" "}
        <a href="https://app.alma.com.do">app.alma.com.do</a> and do the same under{" "}
        <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
      <p>
        Without access to the app, email <a href="mailto:hello@alma.com.do">hello@alma.com.do</a> from your account's
        email address to ask us to delete it. Sign-in security records are kept for up to 90 days.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
