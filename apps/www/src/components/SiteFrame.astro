---
import type { FaqItem } from "../alternatives";
import { faqPageSchema } from "../alternatives";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

type Props = {
  title: string;
  description: string;
  faq?: readonly FaqItem[];
  structuredData?: object;
  ogImage?: string;
  ogType?: string;
  index?: boolean;
};

const {
  title,
  description,
  faq,
  structuredData: structuredDataProp,
  ogImage,
  ogType,
  index = true,
} = Astro.props;
const structuredData =
  structuredDataProp ?? (faq && faq.length > 0 ? faqPageSchema(faq) : undefined);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  localeAlternates={false}
  ogImage={ogImage}
  ogType={ogType}
  index={index}
>
  <div class="container">
    <Header />
    <main id="main" class="alt-page">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
