---
import type { HomeCopy } from "../i18n/home";
import { APP_URL, IOS_APP_URL } from "../site";

type Props = {
  class: string;
  copy: HomeCopy["hero"];
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
};

const { class: className, copy, placement } = Astro.props;
---

<div class={className}>
  <a
    class="button button--primary"
    href={APP_URL}
    data-show="mac windows linux web"
    data-attr={`${placement}-start`}
  >
    {copy.getStarted}
  </a>
  <a class="button button--primary" href={IOS_APP_URL} data-show="ios">{copy.download.ios}</a>
</div>
