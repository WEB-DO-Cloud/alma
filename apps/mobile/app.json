{
  "expo": {
    "name": "ALMA",
    "slug": "alma",
    "scheme": ["alma", "rakazo"],
    "version": "1.0.12",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#002D62",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#002D62"
          },
          "ios": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 240,
            "backgroundColor": "#002D62",
            "dark": {
              "image": "./assets/splash-icon.png",
              "backgroundColor": "#002D62"
            }
          },
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 192,
            "backgroundColor": "#002D62",
            "dark": {
              "image": "./assets/splash-icon-android.png",
              "backgroundColor": "#002D62"
            }
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "ALMA uses the microphone so you can dictate a message."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "ALMA turns your speech into a message.",
          "microphonePermission": "ALMA uses the microphone so you can dictate a message."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ALMA uses your photo library so you can attach an image to a message.",
          "cameraPermission": "ALMA uses the camera so you can attach a photo to a message.",
          "microphonePermission": "ALMA uses the microphone so you can dictate a message."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-lan-cleartext",
      "./plugins/with-strip-foreground-services",
      "./plugins/with-app-intents"
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "ios": {
      "bundleIdentifier": "do.alma.app",
      "buildNumber": "66",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "ALMA uses the camera so you can attach a photo to a message.",
        "NSPhotoLibraryUsageDescription": "ALMA uses your photo library so you can attach an image to a message.",
        "NSLocalNetworkUsageDescription": "ALMA connects to your firm's server on the local network.",
        "CFBundleDisplayName": "ALMA",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "do.alma.app",
      "versionCode": 14,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RakazoWidgets",
                  "bundleIdentifier": "do.alma.app.widgets"
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
