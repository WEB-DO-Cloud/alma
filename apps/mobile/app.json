{
  "expo": {
    "name": "ALMA",
    "slug": "alma",
    "owner": "damiencals-team",
    "scheme": ["alma", "rakazo"],
    "version": "1.0.13",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#002D62",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#002D62"
          },
          "ios": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 240,
            "backgroundColor": "#002D62",
            "dark": {
              "image": "./assets/splash-icon.png",
              "backgroundColor": "#002D62"
            }
          },
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 192,
            "backgroundColor": "#002D62",
            "dark": {
              "image": "./assets/splash-icon-android.png",
              "backgroundColor": "#002D62"
            }
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "ALMA uses the microphone for dictation and voice calls."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "ALMA turns your speech into a message.",
          "microphonePermission": "ALMA uses the microphone for dictation and voice calls."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ALMA uses your photo library so you can attach an image to a message.",
          "cameraPermission": "ALMA uses the camera so you can attach a photo to a message.",
          "microphonePermission": "ALMA uses the microphone for dictation and voice calls."
        }
      ],
      "./plugins/with-share-extension",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.rakazo.app",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/mp4",
              "application/pdf",
              "application/json",
              "application/zip"
            ]
          }
        }
      ],
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-lan-cleartext",
      "./plugins/with-strip-foreground-services",
      "./plugins/with-android-no-gwp-asan",
      "./plugins/with-agent-notifications",
      "./plugins/with-android-r8",
      "./plugins/with-app-intents",
      "./plugins/with-credential-versions"
    ],
    "locales": {
      "es": "./locales/es.json",
      "pl": "./locales/pl.json"
    },
    "ios": {
      "bundleIdentifier": "do.alma.app",
      "buildNumber": "67",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "ALMA uses the camera so you can attach a photo to a message.",
        "NSPhotoLibraryUsageDescription": "ALMA uses your photo library so you can attach an image to a message.",
        "NSMicrophoneUsageDescription": "ALMA uses the microphone for dictation and voice calls.",
        "NSLocalNetworkUsageDescription": "ALMA connects to your firm's server on the local network.",
        "CFBundleDisplayName": "ALMA",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["voip", "audio", "remote-notification"],
        "NSUserActivityTypes": ["INSendMessageIntent"]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "android": {
      "package": "do.alma.app",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RakazoWidgets",
                  "bundleIdentifier": "do.alma.app.widgets"
                },
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "do.alma.app.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.rakazo.app"]
                  }
                },
                {
                  "targetName": "AgentNotifications",
                  "bundleIdentifier": "do.alma.app.notifications",
                  "entitlements": {
                    "com.apple.developer.usernotifications.communication": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
