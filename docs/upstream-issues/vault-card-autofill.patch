@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { cardAutofillTraits, noAutofillTraits } from "./card-autofill";
+
+describe("card autofill traits", () => {
+  it("marks each card field important and names the card content type", () => {
+    expect(cardAutofillTraits("number", "ios")).toEqual({
+      importantForAutofill: "yes",
+      autoComplete: "cc-number",
+      textContentType: "creditCardNumber",
+    });
+    expect(cardAutofillTraits("expiry", "ios")).toEqual({
+      importantForAutofill: "yes",
+      autoComplete: "cc-exp",
+      textContentType: "creditCardExpiration",
+    });
+    expect(cardAutofillTraits("cvc", "ios")).toEqual({
+      importantForAutofill: "yes",
+      autoComplete: "cc-csc",
+      textContentType: "creditCardSecurityCode",
+    });
+    expect(cardAutofillTraits("name", "ios")).toEqual({
+      importantForAutofill: "yes",
+      autoComplete: "cc-name",
+      textContentType: "creditCardName",
+    });
+  });
+
+  it("uses the Android name hint React Native maps, and leaves the other tokens alone", () => {
+    expect(cardAutofillTraits("name", "android").autoComplete).toBe("name");
+    expect(cardAutofillTraits("number", "android").autoComplete).toBe("cc-number");
+    expect(cardAutofillTraits("expiry", "android").autoComplete).toBe("cc-exp");
+    expect(cardAutofillTraits("cvc", "android").autoComplete).toBe("cc-csc");
+    expect(cardAutofillTraits("name", "android").importantForAutofill).toBe("yes");
+  });
+
+  it("keeps a title and a note out of autofill", () => {
+    expect(noAutofillTraits()).toEqual({
+      importantForAutofill: "no",
+      autoComplete: "off",
+      textContentType: "none",
+    });
+  });
+});
diff --git a/apps/mobile/lib/card-autofill.ts b/apps/mobile/lib/card-autofill.ts
new file mode 100644
index 000000000..1d31d2106
--- /dev/null
+++ b/apps/mobile/lib/card-autofill.ts
@@ -0,0 +1,49 @@
+import type { TextInputProps } from "react-native";
+
+/** A card field the system or a password manager can fill. Title and notes are not one of these. */
+export type CardAutofillField = "number" | "expiry" | "cvc" | "name";
+
+export type CardAutofillTraits = Required<
+  Pick<TextInputProps, "autoComplete" | "textContentType" | "importantForAutofill">
+>;
+
+/**
+ * Hints for one card field. Android drops a token it does not know and sets
+ * `importantForAutofill` to `no`; `cc-name` is not a token it knows, `name` is. A known token
+ * does not mark the field important, so each field says yes. iOS reads `textContentType`, and
+ * that wins when both are set.
+ */
+export function cardAutofillTraits(field: CardAutofillField, os: string): CardAutofillTraits {
+  const importantForAutofill = "yes" as const;
+  switch (field) {
+    case "number":
+      return {
+        importantForAutofill,
+        autoComplete: "cc-number",
+        textContentType: "creditCardNumber",
+      };
+    case "expiry":
+      return {
+        importantForAutofill,
+        autoComplete: "cc-exp",
+        textContentType: "creditCardExpiration",
+      };
+    case "cvc":
+      return {
+        importantForAutofill,
+        autoComplete: "cc-csc",
+        textContentType: "creditCardSecurityCode",
+      };
+    case "name":
+      return {
+        importantForAutofill,
+        autoComplete: os === "android" ? "name" : "cc-name",
+        textContentType: "creditCardName",
+      };
+  }
+}
+
+/** A title, a label, or a note. Not card data, so autofill stays off. */
+export function noAutofillTraits(): CardAutofillTraits {
+  return { importantForAutofill: "no", autoComplete: "off", textContentType: "none" };
+}
